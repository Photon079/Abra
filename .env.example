# Abra Life OS — Environment Configuration
# Copy this to .env and fill in your values
# Or run: python3 scripts/setup.py

# ── Notion Integration ──
# Create an integration at: https://www.notion.so/my-integrations
NOTION_TOKEN="your_notion_integration_secret"
NOTION_DIARY_DB_ID="your_diary_database_id"
NOTION_TASKS_DB_ID="your_tasks_database_id"
NOTION_BRAIN_PAGE_ID="your_brain_parent_page_id"

# ── Chess.com ──
# No API key needed — just your public username
CHESSCOM_USERNAME="your_chess_username"

# ── LLM Provider ──
# Options: "gemini", "groq", "cerebras"
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key"
GROQ_API_KEY="your_groq_api_key"
CEREBRAS_API_KEY=""

# ── Strava ──
# Create an app at: https://www.strava.com/settings/api
# Set callback domain to: localhost
STRAVA_CLIENT_ID="your_strava_client_id"
STRAVA_CLIENT_SECRET="your_strava_client_secret"
STRAVA_ATHLETE_ID="your_numeric_athlete_id"
STRAVA_ACCESS_TOKEN="your_strava_access_token"
STRAVA_REFRESH_TOKEN="your_strava_refresh_token"
STRAVA_TOKEN_EXPIRES_AT=""

# ── Targets (optional) ──
STRAVA_WEEKLY_KM_TARGET=30
STRAVA_WEEKLY_MINS_TARGET=180

# ── Cognee Cloud (v2 graph memory) ──
# Create an API key in the Cognee Cloud console: https://platform.cognee.ai
# When USE_GRAPH_MEMORY is false (or the key is missing), Abra falls back to the
# legacy Notion memory loader — the app still runs.
USE_GRAPH_MEMORY=false
COGNEE_API_KEY=""
COGNEE_CLOUD_URL="https://your-tenant.aws.cognee.ai"
# Optional tuning:
COGNEE_DATASET="abra"
COGNEE_TOP_K=10
